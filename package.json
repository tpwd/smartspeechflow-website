{
  "name": "smart-speech-flow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mehrsprachige Landingpage für Smart Speech Flow (statisch, Astro)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && node scripts/check-i18n.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "validate": "astro build && html-validate \"dist/**/*.html\""
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.8",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "html-validate": "11.16.3",
    "typescript": "5.9.3"
  }
}
