---
import PageHead from '../components/PageHead.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  doc: 'notice' | 'privacy';
}
const { locale, doc } = Astro.props;
const { t, tv } = useTranslations(locale);
type Section = { title: string; lines?: string[]; paragraphs?: string[]; list?: string[]; after?: string[] };
const sections = tv<Section[]>(`legal.${doc}.sections`);
const note = t('legal.translationNote');
---
<PageHead locale={locale} current={t(`legal.${doc}.title`)} title={t(`legal.${doc}.title`)} />

<section class="section">
  <div class="container legal">
    {note && <p class="note t-body-xs">{note}</p>}
    {sections.map((s) => (
      <section>
        <h2 class="t-h5">{s.title}</h2>
        {s.lines && <p>{s.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>}
        {s.paragraphs?.map((p) => <p>{p}</p>)}
        {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
        {s.after?.map((p) => <p>{p}</p>)}
      </section>
    ))}
  </div>
</section>

<style>
  .legal { display: grid; gap: var(--spacing-32); max-inline-size: 792px; margin-inline: auto; }
  .legal section { display: grid; gap: 12px; }
  .legal p, .legal li { color: var(--color-gray-cool-700); }
  .legal ul { margin: 0; padding-inline-start: 1.2em; display: grid; gap: 4px; }
  .note { padding: 12px var(--spacing-16); border-radius: var(--radius-8); background: var(--color-petrol-050); }
</style>
