---
// Phosphor Light (MIT), wie in der Figma-Library. SVGs liegen in src/icons/.
const sources = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

export type IconName =
  | 'arrow-right' | 'arrow-square-out' | 'bell' | 'caret-down' | 'caret-right'
  | 'check' | 'globe' | 'list' | 'x';

interface Props {
  name: IconName;
  size?: 16 | 20 | 24;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const raw = sources[`../icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" fehlt in src/icons/`);
const directional = name === 'arrow-right' || name === 'caret-right';
const svg = raw.replace(
  '<svg ',
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="icon${directional ? ' icon--directional' : ''}${className ? ' ' + className : ''}" `,
);
---
<Fragment set:html={svg} />
