---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { pathFor } from '../i18n/config';
import { t } from '../i18n';
---
<Base locale="de" page={null}>
  <section class="section">
    <div class="container stack" style="--stack-gap: var(--spacing-24)">
      <h1 class="t-hero">{t('de', 'notFound.title')}</h1>
      <p class="t-body-l">{t('de', 'notFound.text')}</p>
      <p lang="en" class="t-body-m">{t('en', 'notFound.text')} <a href={pathFor('en', 'home')}>{t('en', 'notFound.back')}</a></p>
      <Button href={pathFor('de', 'home')} variant="secondary-dark">{t('de', 'notFound.back')}</Button>
    </div>
  </section>
</Base>
