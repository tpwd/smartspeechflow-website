---
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/noto-sans-arabic/400.css';
import '@fontsource/noto-sans-arabic/700.css';
import '@fontsource/noto-sans-devanagari/400.css';
import '@fontsource/noto-sans-devanagari/700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, isRtl, localeTags, pathFor, type Locale, type PageKey } from '../i18n/config';
import { indexableLocales, isComplete, t } from '../i18n';
import { structuredData } from '../lib/seo';

interface Props {
  locale: Locale;
  /** null = Seite ohne festen Pfad (404) */
  page: PageKey | null;
}

const { locale, page } = Astro.props;
const site = Astro.site ?? new URL('https://smartspeechflow.de');
const seoKey = page ?? 'notFound';
const title = t(locale, `seo.${seoKey}.title`);
const description = t(locale, `seo.${seoKey}.description`);

// Unvollständig übersetzte Sprachen zeigen deutschen Text: dann ehrlich als Deutsch auszeichnen,
// nicht indexieren und auf die deutsche Fassung als Original verweisen.
const complete = isComplete(locale);
const contentLocale: Locale = complete ? locale : defaultLocale;
const canonicalLocale: Locale = complete ? locale : defaultLocale;
const canonical = page ? new URL(pathFor(canonicalLocale, page), site).href : null;

const noindexEnv = import.meta.env.PUBLIC_NOINDEX !== 'false';
const indexable = !noindexEnv && complete && page !== null && page !== 'thanks';
const ogImage = new URL(`/og/${contentLocale === 'en' ? 'en' : 'de'}.png`, site).href;
const jsonLd = page ? structuredData(contentLocale, page, title, description) : null;
---
<!doctype html>
<html lang={localeTags[contentLocale]} dir={isRtl(contentLocale) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {page && complete && indexableLocales.map((l) => (
      <link rel="alternate" hreflang={localeTags[l]} href={new URL(pathFor(l, page), site).href} />
    ))}
    {page && complete && <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLocale, page), site).href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="theme-color" content="#0a2833" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Smart Speech Flow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(contentLocale, 'hero.headline')} />
    <meta property="og:locale" content={localeTags[contentLocale].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Animationen nur mit JavaScript (siehe styles/motion.css). Nach einem Seitenwechsel mit
      // Überblendung entfällt die Lade-Animation, sonst würde die Seite doppelt einblenden.
      document.documentElement.classList.add('js');
      window.addEventListener('pagereveal', function (e) {
        if (e.viewTransition) document.documentElement.classList.add('vt-nav');
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{t(locale, 'nav.skip')}</a>
    <Header locale={locale} page={page ?? 'home'} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Was beim Scrollen einblendet: Abschnitts-Inhalte und – nacheinander – Karten in Rastern.
        var blocks = document.querySelectorAll('main > section.section > .container > :not(.grid-2, .grid-3, .grid-4)');
        var groups = document.querySelectorAll('main :is(.grid-2, .grid-3, .grid-4) > *, main .trust li');
        var items = [];
        blocks.forEach(function (el) { if (!el.matches('.grid-2, .grid-3, .grid-4')) items.push(el); });
        groups.forEach(function (el) {
          el.style.setProperty('--i', String(Math.min(Array.prototype.indexOf.call(el.parentElement.children, el), 5)));
          items.push(el);
        });
        items.forEach(function (el) {
          el.classList.add('reveal');
          // Schon sichtbar: kommt mit dem Seitenaufbau, ohne eigene Verzögerung
          if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('reveal--instant', 'is-visible');
        });
        // Bilder einblenden, sobald sie geladen sind
        document.querySelectorAll('main img').forEach(function (img) {
          var done = function () { img.classList.add('is-loaded'); };
          if (img.complete) done(); else { img.addEventListener('load', done, { once: true }); img.addEventListener('error', done, { once: true }); }
        });
        requestAnimationFrame(function () { requestAnimationFrame(function () { root.classList.add('is-loaded'); }); });
        if (!reduce && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          items.forEach(function (el) { if (!el.classList.contains('is-visible')) io.observe(el); });
        } else {
          items.forEach(function (el) { el.classList.add('is-visible'); });
        }
      })();
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
