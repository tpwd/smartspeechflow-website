---
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/noto-sans-arabic/400.css';
import '@fontsource/noto-sans-arabic/700.css';
import '@fontsource/noto-sans-devanagari/400.css';
import '@fontsource/noto-sans-devanagari/700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, isRtl, locales, localeTags, pathFor, type Locale, type PageKey } from '../i18n/config';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description?: string;
}

const { locale, page, title, description = t(locale, 'meta.description') } = Astro.props;
const site = Astro.site ?? new URL('https://smartspeechflow.de');
const canonical = new URL(pathFor(locale, page), site).href;
// Bis zum Go-live: noindex (siehe .env.example).
const noindex = import.meta.env.PUBLIC_NOINDEX !== 'false';
const indexable = noindex ? false : page !== 'thanks';
---
<!doctype html>
<html lang={localeTags[locale]} dir={isRtl(locale) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={localeTags[l]} href={new URL(pathFor(l, page), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLocale, page), site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{t(locale, 'nav.skip')}</a>
    <Header locale={locale} page={page} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
