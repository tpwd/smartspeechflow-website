# Kopie als .env anlegen und anpassen. .env wird nicht eingecheckt.

# Solange "true", tragen alle Seiten <meta name="robots" content="noindex"> und
# robots.txt sperrt Crawler. Erst beim Go-live auf "false" setzen.
PUBLIC_NOINDEX=true

# Ziel-URL für das Buchungsformular (POST). Leer = kein Backend:
# Das Formular leitet dann nur zur Danke-Seite weiter (Demo-Modus, sendet nichts).
PUBLIC_BOOKING_ENDPOINT=
