# Kopie als .env anlegen und anpassen. .env wird nicht eingecheckt.
# Auf Netlify dieselben Variablen unter Site configuration → Environment variables eintragen.

# Solange "true", tragen alle Seiten noindex und robots.txt sperrt Crawler. Erst beim Go-live auf "false".
PUBLIC_NOINDEX=true

# --- Pipedrive (SVS) ---
# API-Token: Pipedrive → Persönliche Einstellungen → API. Geheim halten!
PIPEDRIVE_API_TOKEN=
# Firmen-Subdomain, z. B. "svs" für https://svs.pipedrive.com
PIPEDRIVE_DOMAIN=
# Nur für automatische Tests mit einem nachgebauten Pipedrive-Server. Live immer leer lassen.
# PIPEDRIVE_BASE_URL=
# IDs der Pipeline „Smart Speech Flow Form“ und ihrer Phasen (siehe README)
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_BOOKING_STAGE_ID=
# Optional: Kontaktanfragen als Deal in diese Phase. Leer = Kontaktanfragen landen als Lead im Lead-Eingang.
PIPEDRIVE_CONTACT_STAGE_ID=

# --- Optional: E-Mails über Resend ---
# Ohne diese Werte werden keine Mails verschickt; die Danke-Seite verspricht dann auch keine.
RESEND_API_KEY=
MAIL_FROM=Smart Speech Flow <buchung@smartspeechflow.de>
MAIL_NOTIFY_TO=

# Nur lokal zum Ausprobieren ohne Pipedrive: Formulare melden Erfolg, es wird NICHTS übertragen.
FORMS_DEMO=false
